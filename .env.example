# .env.example — vector_search configuration
#
# Copy to `.env` and edit as needed:  cp .env.example .env
#
# Convention in this file:
#   • Lines starting with `#` followed by a space are explanatory comments.
#   • `KEY=value` lines are ACTIVE settings, shown at their built-in defaults.
#   • `#KEY=value` lines (no space after #) are OPTIONAL/secret settings that are
#     unset by default — uncomment and fill in to enable them.
#
# Nothing here needs editing to run locally: the defaults target a local Qdrant
# (docker compose up -d qdrant) with the local fastembed backend. Values are read
# from os.environ at import time (see packages/vector_search/src/config.py and
# .../embedder.py); integer settings must be a positive integer or import fails.


# ─────────────────────────────────────────────────────────────────────────────
# Qdrant connection
# ─────────────────────────────────────────────────────────────────────────────

# HTTP address of the Qdrant instance. Local Docker listens on 6333.
# For Qdrant Cloud, use the cluster URL, e.g. https://<cluster>.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# API key for Qdrant Cloud. Leave unset for the local Docker container (no auth);
# setting it to an empty string over plain http emits an insecure-connection
# warning, so keep it commented unless you actually have a key.
#QDRANT_API_KEY=your-qdrant-cloud-key


# ─────────────────────────────────────────────────────────────────────────────
# Embedding backend selection
# ─────────────────────────────────────────────────────────────────────────────
# When OPENAI_API_KEY is set and non-empty, the OpenAI backend is used;
# otherwise the pipeline falls back to the local backend configured below.

# OpenAI API key. Uncomment to embed via the OpenAI /v1/embeddings endpoint.
#OPENAI_API_KEY=sk-...

# OpenAI embedding model (also used by tiktoken for chunk sizing). Known dims:
# text-embedding-3-small=1536, text-embedding-3-large=3072, ada-002=1536.
VECTOR_SEARCH_OPENAI_MODEL=text-embedding-3-small

# Explicit OpenAI output dimension (positive int). When set, it is forwarded as
# the `dimensions` request parameter (v3 models support shortened embeddings)
# and used as the collection dimension. Unset → derived from the model.
#VECTOR_SEARCH_OPENAI_DIM=1536


# ─────────────────────────────────────────────────────────────────────────────
# Local backend (used only when OPENAI_API_KEY is unset)
# ─────────────────────────────────────────────────────────────────────────────

# Local runtime: `fastembed` (ONNX, no torch) or `sentence-transformers` (torch).
VECTOR_SEARCH_LOCAL_BACKEND=fastembed

# Local embedding model. Dims: bge-large-en-v1.5=1024, bge-base-en-v1.5=768,
# bge-small-en-v1.5=384. The large default downloads ~1.3 GB on first use;
# bge-small is a fast, low-footprint alternative.
VECTOR_SEARCH_LOCAL_MODEL=BAAI/bge-large-en-v1.5

# Cap on ONNX (fastembed) threads. 0 lets the runtime choose its own count.
VECTOR_SEARCH_EMBED_THREADS=0


# ─────────────────────────────────────────────────────────────────────────────
# Batching (all positive integers)
# ─────────────────────────────────────────────────────────────────────────────

# Chunks buffered before the backend is asked to embed them.
VECTOR_SEARCH_PIPELINE_CHUNK_BATCH_SIZE=100

# Microbatch size for the local ONNX / sentence-transformers backends; primary
# control for native inference workspace memory.
VECTOR_SEARCH_LOCAL_INFERENCE_BATCH_SIZE=16

# Texts sent in one OpenAI embeddings API request.
VECTOR_SEARCH_OPENAI_REQUEST_BATCH_SIZE=100

# Points written per Qdrant upsert call. Larger = more efficient, more peak memory.
VECTOR_SEARCH_QDRANT_UPSERT_BATCH_SIZE=200

# DEPRECATED single fallback for the three embed batch sizes above (not the
# Qdrant upsert size). Any explicit setting above takes precedence.
#VECTOR_SEARCH_EMBED_BATCH_SIZE=100


# ─────────────────────────────────────────────────────────────────────────────
# Resource monitoring
# ─────────────────────────────────────────────────────────────────────────────

# Soft peak-RSS ceiling (MB): the pipeline logs a warning if measured peak RSS
# exceeds it. Unset → disabled.
#VECTOR_SEARCH_MEM_CEILING_MB=2048
