# .env.example — vector_search configuration
#
# Copy to `.env` and uncomment/edit as needed. Every value below has a working
# default (shown after "default:"), so an empty .env runs against a local Qdrant
# with the local fastembed backend — no secrets required.
#
# All variables are read once at import time (see
# packages/vector_search/src/config.py and .../embedder.py). Integer settings
# must parse as a positive integer or import fails with a ValueError.

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant connection
# ─────────────────────────────────────────────────────────────────────────────

# HTTP address of the Qdrant instance.
# Local Docker (docker compose up -d qdrant) listens on 6333.
# For Qdrant Cloud, use the cluster URL, e.g. https://<cluster>.cloud.qdrant.io:6333
# default: http://localhost:6333
# QDRANT_URL=http://localhost:6333

# API key for Qdrant Cloud. Leave unset/blank for the local Docker container,
# which needs no auth.
# default: (unset → None)
# QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Embedding backend selection
# ─────────────────────────────────────────────────────────────────────────────
# If OPENAI_API_KEY is set and non-empty, the OpenAI backend is used.
# Otherwise the pipeline falls back to a local backend (see below).

# OpenAI API key. Set it to embed via the OpenAI /v1/embeddings endpoint.
# default: (unset → local backend is used)
# OPENAI_API_KEY=sk-...

# OpenAI embedding model. Also used by tiktoken for chunk sizing.
# Known dims: text-embedding-3-small=1536, text-embedding-3-large=3072,
# text-embedding-ada-002=1536.
# default: text-embedding-3-small
# VECTOR_SEARCH_OPENAI_MODEL=text-embedding-3-small

# Explicit output dimension (positive int). When set, it is forwarded to OpenAI
# as the `dimensions` parameter (v3 models support shortened embeddings) and used
# as the Qdrant collection dimension. Leave unset to derive it from the model.
# default: (unset → derived from the model)
# VECTOR_SEARCH_OPENAI_DIM=1536

# ─────────────────────────────────────────────────────────────────────────────
# Local backend (used only when OPENAI_API_KEY is unset)
# ─────────────────────────────────────────────────────────────────────────────

# Which local runtime to use:
#   fastembed             — ONNX Runtime, no torch (light, default)
#   sentence-transformers — torch backend (heavier; pip install sentence-transformers torch)
# default: fastembed
# VECTOR_SEARCH_LOCAL_BACKEND=fastembed

# Local embedding model. Dims: bge-large-en-v1.5=1024, bge-base-en-v1.5=768,
# bge-small-en-v1.5=384. The large default downloads ~1.3 GB on first use;
# bge-small is a fast, low-footprint alternative.
# default: BAAI/bge-large-en-v1.5
# VECTOR_SEARCH_LOCAL_MODEL=BAAI/bge-large-en-v1.5

# Cap on threads the local ONNX (fastembed) backend may use.
# 0 (or unset) lets the runtime choose its own thread count.
# default: 0 (auto)
# VECTOR_SEARCH_EMBED_THREADS=0

# ─────────────────────────────────────────────────────────────────────────────
# Batching (all positive integers)
# ─────────────────────────────────────────────────────────────────────────────

# How many chunks the streaming pipeline buffers before asking the backend to
# embed them. Bounds Python-side chunk/vector/point buffering.
# default: 100
# VECTOR_SEARCH_PIPELINE_CHUNK_BATCH_SIZE=100

# Microbatch size for the local ONNX / sentence-transformers backends. Primary
# control for native inference workspace memory.
# default: 16
# VECTOR_SEARCH_LOCAL_INFERENCE_BATCH_SIZE=16

# Number of texts sent in one OpenAI embeddings API request.
# default: 100
# VECTOR_SEARCH_OPENAI_REQUEST_BATCH_SIZE=100

# How many Qdrant PointStructs are written per upsert call. Larger batches are
# more efficient but raise peak memory.
# default: 200
# VECTOR_SEARCH_QDRANT_UPSERT_BATCH_SIZE=200

# DEPRECATED compatibility fallback for the three batch sizes above (pipeline,
# local inference, OpenAI request). Any explicit setting above takes precedence.
# Does NOT affect the Qdrant upsert batch size.
# default: (unset)
# VECTOR_SEARCH_EMBED_BATCH_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# Resource monitoring
# ─────────────────────────────────────────────────────────────────────────────

# Optional soft ceiling (MB). When set and measured peak RSS exceeds it, the
# pipeline logs a warning. Unset disables the check.
# default: (unset → disabled)
# VECTOR_SEARCH_MEM_CEILING_MB=2048
